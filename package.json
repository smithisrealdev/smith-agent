{
  "name": "smith-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Smith Agent MVP: a LINE bot that quotes a price before it starts, runs a web task with Claude, and sends the result with evidence. No charge when it fails.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --env-file=test/test.env --test",
    "stats": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli.js stats"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "sharp": "^0.35.5"
  }
}
