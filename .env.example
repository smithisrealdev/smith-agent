ANTHROPIC_API_KEY=

# LINE bot (optional). Leave both empty to run the web app only.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login for the web app (optional). With both set and PUBLIC_URL, every phone must sign in with LINE.
# Register PUBLIC_URL/auth/line/callback as the callback URL of the LINE Login channel.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Set before the web app can be reached from the internet, so strangers can't spend your Claude credit.
WEB_INVITE_CODE=
# Quotes each user may ask for per hour (each quote is a paid Claude call).
QUOTES_PER_HOUR=30
# Most Claude cost (baht) the server accepts per Thai day, all users together. 0 turns the cap off.
DAILY_COST_CAP=500

# Public https address of this server. Needed only to show evidence screenshots in LINE.
PUBLIC_URL=
PORT=3000

# Claude model. claude-sonnet-5-5 or claude-haiku-5-5 cost less; compare with `npm run stats`.
SMITH_MODEL=claude-opus-5-5
# Credit every new user starts with ("first job free, up to ฿20"), in whole baht.
START_CREDIT=20
# What a small / medium / large job costs, in whole baht. A bigger job must not cost less than a smaller one.
# Change them between groups of testers, not during a job: a quote keeps the price it was made at.
PRICE_S=5
PRICE_M=9
PRICE_L=15
USD_THB=36

DB_PATH=data/smith.db
EVIDENCE_DIR=data/evidence
