ANTHROPIC_API_KEY=

# LINE bot (optional). Leave both empty to run the web app only.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login for the web app (optional). With both set and PUBLIC_URL, every phone must sign in with LINE.
# Register PUBLIC_URL/auth/line/callback as the callback URL of the LINE Login channel.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Set before the web app can be reached from the internet, so strangers can't spend your Claude credit.
WEB_INVITE_CODE=
# Quotes each user may ask for per hour (each quote is a paid Claude call).
QUOTES_PER_HOUR=30
# Turns on GET /admin/backup, a staff-only download of the database (send it as "Authorization: Bearer <token>").
# At least 32 characters or the server will not start; leave empty to keep the route off.
ADMIN_TOKEN=
# Most Claude cost (baht) the server accepts per Thai day, all users together. 0 turns the cap off.
DAILY_COST_CAP=500

# Public https address of this server. Needed only to show evidence screenshots in LINE.
PUBLIC_URL=
PORT=3000

# Claude model. claude-sonnet-5-5 or claude-haiku-5-5 cost less; compare with `npm run stats`.
SMITH_MODEL=claude-opus-5-5
# Credit every new user starts with, in whole baht. Empty = three medium jobs (3 x PRICE_M).
START_CREDIT=
# Most accounts allowed in the test round (the invite code is shared, so it limits no one). 0 = no limit.
MAX_USERS=0
# Your own LINE user id (type "เครดิต" to the bot to see it): the bot messages you about top-ups, refunds to review and the daily cap.
ADMIN_LINE_ID=
# Push messages a month on your LINE OA plan (Thailand free plan: 300). Stats warns at 80%. 0 = do not show.
LINE_PUSH_QUOTA=300
# Manual PromptPay top-ups (off while empty). Users see this number and name, transfer, then tap "โอนแล้ว"; staff approve with `node src/cli.js topup <id>`.
TOPUP_PROMPTPAY=
TOPUP_NAME=
TOPUP_AMOUNT=50
# What a small / medium / large job costs, in whole baht. A bigger job must not cost less than a smaller one.
# Change them between groups of testers, not during a job: a quote keeps the price it was made at.
PRICE_S=5
PRICE_M=9
PRICE_L=15
USD_THB=36

DB_PATH=data/smith.db
EVIDENCE_DIR=data/evidence
