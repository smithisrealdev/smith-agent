ANTHROPIC_API_KEY=

# LINE bot (optional). Leave both empty to run the web app only.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Set before the web app can be reached from the internet, so strangers can't spend your Claude credit.
WEB_INVITE_CODE=
# Quotes each user may ask for per hour (each quote is a paid Claude call).
QUOTES_PER_HOUR=30

# Public https address of this server. Needed only to show evidence screenshots in LINE.
PUBLIC_URL=
PORT=3000

# Claude model. claude-sonnet-5-5 or claude-haiku-5-5 cost less; compare with `npm run stats`.
SMITH_MODEL=claude-opus-5-5
# Credit every new user starts with ("first job free, up to ฿20").
START_CREDIT=20
USD_THB=36

DB_PATH=data/smith.db
EVIDENCE_DIR=data/evidence
